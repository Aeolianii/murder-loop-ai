AI_SERVER_PORT=8788

# Provider-level configuration. Any OpenAI-compatible service can be used by filling API_KEY, BASE_URL and MODEL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional comma-separated DeepSeek key pool. Used when role-specific keys are empty.
DEEPSEEK_API_KEYS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_KILLER_API_KEY=
DEEPSEEK_KILLER_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_KILLER_MODEL=deepseek-v4-flash
DEEPSEEK_NARRATOR_API_KEY=
DEEPSEEK_NARRATOR_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_NARRATOR_MODEL=deepseek-v4-flash
DEEPSEEK_NPC_API_KEY=
DEEPSEEK_NPC_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_NPC_MODEL=deepseek-v4-flash
DEEPSEEK_RECAP_API_KEY=
DEEPSEEK_RECAP_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_RECAP_MODEL=deepseek-v4-pro

DUCKINGMIND_API_KEY=
DUCKINGMIND_BASE_URL=https://api.duckingmind.com/v1
DUCKINGMIND_MODEL=gpt-4o-mini

# Role-level routing. Supported providers: openai, deepseek, deepseek_killer, deepseek_narrator, deepseek_npc, deepseek_recap, duckingmind.
AI_PARSE_PROVIDER=deepseek
AI_KILLER_PROVIDER=deepseek_killer
AI_NARRATOR_PROVIDER=deepseek_narrator
AI_DIRECTOR_PROVIDER=deepseek_recap
AI_NPC_PROVIDER=deepseek_npc
AI_RECAP_PROVIDER=deepseek_recap

# Optional per-role model override.
AI_PARSE_MODEL=deepseek-v4-flash
AI_KILLER_MODEL=deepseek-v4-flash
AI_NARRATOR_MODEL=deepseek-v4-flash
AI_DIRECTOR_MODEL=deepseek-v4-pro
AI_NPC_MODEL=deepseek-v4-flash
AI_RECAP_MODEL=deepseek-v4-pro

# Role-level request budget. Timeout means "API did not return in time", then the role falls back for this turn.
